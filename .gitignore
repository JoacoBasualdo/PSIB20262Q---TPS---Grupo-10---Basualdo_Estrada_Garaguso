# Datos pesados (Dataset de Physionet)
Dataset/
data/
*.edf
*.csv

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
.env

# Cuadernos Jupyter (si usan para pruebas)
.ipynb_checkpoints/

# Configuraciones de IDEs locales (VS Code, PyCharm, etc.)
.vscode/
.idea/

# Archivos ocultos del sistema operativo
.DS_Store
Thumbs.db

# OpenSim: la plantilla y los modelos se versionan; los resultados no
!OpenSim/Modelos/*.csv
OpenSim/**/*.sto
OpenSim/S*/
*.log

# Resultados generados por el programa
resultados.pdf

# Archivos auxiliares de LaTeX
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# Archivos comprimidos del dataset
*.tar.gz
*.zip
